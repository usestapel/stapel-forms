  "type": "object",
  "additionalProperties": false,
  "required": ["form_id", "workspace_id", "version"],
  "properties": {
    "form_id": {"type": "string"},
    "workspace_id": {"type": "string"},
    "version": {"type": "integer"}
  }
}
