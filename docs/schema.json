                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/forms/api/v1/forms/{form_id}/submissions/export": {
      "get": {
        "operationId": "forms_api_v1_forms_submissions_export_retrieve",
        "description": "Stream responses as CSV.\n\nStreamed and page-capped rather than materialized: an export is the one\nread whose size is chosen by whoever filled the form in. The\nformula-injection escape lives in ``export.py`` so every consumer of\nthe CSV inherits it.\n\n**Permissions:** `IsNotAnonymousUser`",
        "parameters": [
          {
            "in": "query",
            "name": "before",
            "schema": {
              "type": "string"
            },
            "description": "Keyset continuation, echoed back in the X-Forms-Next-Before header."
          },
          {
            "in": "path",
            "name": "form_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "version",
            "schema": {
              "type": "integer"
            },
            "description": "Export one schema version's responses (its columns are the header row)."
          },
          {
            "in": "query",
