    "/forms/api/v1/forms/{form_id}/submissions": {
      "get": {
        "operationId": "forms_api_v1_forms_submissions_list",
        "description": "Keyset page of a form's responses, newest first.\n\n**Permissions:** `IsNotAnonymousUser`",
